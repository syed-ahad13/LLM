# Corpus, intermediate data and run logs never go in git (CLAUDE.md).
/data/
/logs/
*.bin
# Lock taken by collect/download.py while it updates sources.json
/collect/sources.json.lock
# Your User-Agent contact address (collect/polite.py); never committed because the repo is public
/collect/contact.local

# The shared-drive link (make_submission.py puts it in the archived README only; the repo is public)
/drive_link.local
/submission/

# Trainer checkpoints (train_tokenizer.py); the finished tokenizer is committed
/tokenizer/*.checkpoint.json
/tokenizer/*.checkpoint.merges.txt

# Python
/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# LaTeX build files (scoped to report/ so evidence/*.log scrape logs stay tracked)
report/**/*.aux
report/**/*.bbl
report/**/*.bcf
report/**/*.blg
report/**/*.fdb_latexmk
report/**/*.fls
report/**/*.lof
report/**/*.log
report/**/*.lot
report/**/*.nav
report/**/*.out
report/**/*.run.xml
report/**/*.snm
report/**/*.synctex.gz
report/**/*.toc
report/**/*.vrb
report/**/*.xdv
report/_minted*/

# OS
.DS_Store
